{
    "name": "reynevan/web3-php",
    "description": "Web3 PHP helpers",
    "type": "library",
    "license": "MIT",
    "keywords": ["ethereum", "evm", "eip1559", "rlp", "ecrecover", "rpc"],
    "require": {
        "php": ">=8.1",
        "ext-gmp": "*",
        "kornrunner/keccak": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Reynevan\\Web3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
    }
}
